class Solution:

    def check(self, nums: list[int]) -> bool:
        count_drops = 0
        n = len(nums)

        for i in range(n):
            # Compare current element with the next one (wraps around to 0 at the end)
            if nums[i] > nums[(i + 1) % n]:
                count_drops += 1

            # If there's more than one drop, it's not a rotated sorted array
            if count_drops > 1:
                return False

        return True
