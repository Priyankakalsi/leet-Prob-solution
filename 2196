# Definition for a binary tree node.
# class TreeNode:
#     def __init__(self, val=0, left=None, right=None):
#         # self.val = val
#         # self.left = left
#         # self.right = right

class Solution:
    def createBinaryTree(self, descriptions: List[List[int]]) -> Optional[TreeNode]:
        nodes = {}
        children = set()
        
        for parent_val, child_val, is_left in descriptions:
            # 1. Create or retrieve the parent node
            if parent_val not in nodes:
                nodes[parent_val] = TreeNode(parent_val)
            parent_node = nodes[parent_val]
            
            # 2. Create or retrieve the child node
            if child_val not in nodes:
                nodes[child_val] = TreeNode(child_val)
            child_node = nodes[child_val]
            
            # 3. Connect parent to child based on is_left
            if is_left == 1:
                parent_node.left = child_node
            else:
                parent_node.right = child_node
                
            # 4. Mark this node as a child
            children.add(child_val)
            
        # 5. The root is the only node value that never appears as a child
        for parent_val, _, _ in descriptions:
            if parent_val not in children:
                return nodes[parent_val]
                
        return None
