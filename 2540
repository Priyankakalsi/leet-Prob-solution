class Solution:
    def getCommon(self, nums1: list[int], nums2: list[int]) -> int:
        p1 = 0  # Pointer for nums1
        p2 = 0  # Pointer for nums2
        
        # Traverse until one pointer reaches the end of its array
        while p1 < len(nums1) and p2 < len(nums2):
            if nums1[p1] == nums2[p2]:
                return nums1[p1]  # Found the smallest common element
            elif nums1[p1] < nums2[p2]:
                p1 += 1           # Move p1 to find a larger value
            else:
                p2 += 1           # Move p2 to find a larger value
                
        return -1  # No common element found
