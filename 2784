from collections import Counter

class Solution:
    def isGood(self, nums: list[int]) -> bool:
        n = len(nums) - 1
        if n < 1:
            return False
            
        counts = Counter(nums)
        
        # Check frequencies for 1 to n-1
        for i in range(1, n):
            if counts[i] != 1:
                return False
                
        # Check frequency for n
        return counts[n] == 2
