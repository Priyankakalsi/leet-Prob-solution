class Solution:
    def search(self, nums: list[int], target: int) -> int:
        left, right = 0, len(nums) - 1
        
        while left <= right:
            mid = (left + right) // 2
            
            if nums[mid] == target:
                return mid
            
            # Condition 1: Check if the left half is strictly sorted
            if nums[left] <= nums[mid]:
                # Check if target lies within the sorted left half range
                if nums[left] <= target < nums[mid]:
                    right = mid - 1
                else:
                    left = mid + 1
                    
            # Condition 2: Otherwise, the right half must be strictly sorted
            else:
                # Check if target lies within the sorted right half range
                if nums[mid] < target <= nums[right]:
                    left = mid + 1
                else:
                    right = mid - 1
                    
        return -1
