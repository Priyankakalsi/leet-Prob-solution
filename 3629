from collections import deque

class Solution:
    def minJumps(self, nums: list[int]) -> int:
        n = len(nums)
        if n <= 1: return 0
        
        max_val = max(max(nums), 2)
        # SPF (Smallest Prime Factor) Sieve for O(log N) factorization
        spf = list(range(max_val + 1))
        for i in range(2, int(max_val**0.5) + 1):
            if spf[i] == i:
                for j in range(i*i, max_val + 1, i):
                    if spf[j] == j:
                        spf[j] = i
        
        # Pre-calculate which indices are reachable by which prime factor
        prime_to_indices = {}
        for i, val in enumerate(nums):
            temp = val
            while temp > 1:
                p = spf[temp]
                if p not in prime_to_indices:
                    prime_to_indices[p] = []
                prime_to_indices[p].append(i)
                while temp % p == 0:
                    temp //= p
                    
        # Primality check for the "teleport from" rule
        is_prime = [True] * (max_val + 1)
        is_prime[0] = is_prime[1] = False
        for i in range(2, int(max_val**0.5) + 1):
            if is_prime[i]:
                for j in range(i*i, max_val + 1, i):
                    is_prime[j] = False

        # BFS
        queue = deque([(0, 0)]) # (current_index, distance)
        visited_idx = [False] * n
        visited_idx[0] = True
        visited_primes = set()
        
        while queue:
            curr_idx, dist = queue.popleft()
            
            if curr_idx == n - 1:
                return dist
            
            # 1. Adjacent Steps (Cost 1)
            for neighbor in [curr_idx - 1, curr_idx + 1]:
                if 0 <= neighbor < n and not visited_idx[neighbor]:
                    visited_idx[neighbor] = True
                    queue.append((neighbor, dist + 1))
            
            # 2. Prime Teleportation (Cost 1)
            # If current number is prime, we can jump to any index divisible by it
            p = nums[curr_idx]
            if p <= max_val and is_prime[p] and p not in visited_primes:
                visited_primes.add(p)
                if p in prime_to_indices:
                    for target_idx in prime_to_indices[p]:
                        if not visited_idx[target_idx]:
                            visited_idx[target_idx] = True
                            queue.append((target_idx, dist + 1))
                            
        return -1
